{
  "name": "wize-market-preview-2026",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-29",
  // Keep variables added in the Cloudflare dashboard (for example TURN_KEY_ID) when deploying with Wrangler.
  "keep_vars": true,
  "build": {
    "command": "node build.mjs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wize-market-auth",
      "database_id": "f9c563ed-7561-42f4-8853-30bcf5338880"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "wize-market-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ai": {
    "binding": "AI"
  },
  // WizeNex (wizenex.com): a separate site with its own worker, database and media. The settings above stay Wize Market's.
  // Deploy with: npx wrangler deploy --env wizenex
  // SITE_HOST: wizenex.com is the one address; workers.dev sends visitors there. The routes serve wizenex.com and www
  // through the existing proxied DNS records (custom domains need those records removed first).
  "env": {
    "wizenex": {
      "name": "wizenex",
      "workers_dev": true,
      "vars": {
        "SITE_HOST": "wizenex.com"
      },
      "routes": [
        { "pattern": "wizenex.com/*", "zone_name": "wizenex.com" },
        { "pattern": "www.wizenex.com/*", "zone_name": "wizenex.com" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wize-market-demo",
          "database_id": "b3d80ef7-d9cd-4ea4-9b12-f939f8adce35"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "wize-market-demo-media"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
