{
  "name": "wize-market-preview-2026",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-29",
  "build": {
    "command": "node build.mjs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wize-market-auth",
      "database_id": "f9c563ed-7561-42f4-8853-30bcf5338880"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "wize-market-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ai": {
    "binding": "AI"
  },
  // WizeNex (wizenex.com): separate new site, copied from Wize Market.
  // Own worker, database and media. The old site above is unchanged.
  // Deploy with: npx wrangler deploy --env wizenex
  "env": {
    "wizenex": {
      "name": "wizenex",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wize-market-demo",
          "database_id": "b3d80ef7-d9cd-4ea4-9b12-f939f8adce35"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "wize-market-demo-media"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
